<Window x:Class="CyberBot.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CyberBot"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid Background="#1E1E1E">
        <!--Parent grid-->

        <!-- BACKGROUND GRID -->
        <Grid 
        x:Name="background_grid"
        Visibility="Hidden"
        >


            <!-- TITLE -->
            <TextBlock
            Text="CYBERSECURITY AWARENESS BOT"
            Foreground="Cyan"
            FontSize="26"
            FontWeight="Bold"
            HorizontalAlignment="Center"
            Margin="0,20,0,0"/>

            <!-- CHAT DISPLAY -->
            <TextBox
            x:Name="chatBox"
            Margin="20,80,20,120"
            Background="#2D2D30"
            Foreground="White"
            FontSize="14"
            TextWrapping="Wrap"
            VerticalScrollBarVisibility="Auto"
            IsReadOnly="True"/>

            <!-- INPUT BOX -->
            <TextBox
            x:Name="inputBox"
            Height="40"
            Margin="20,0,140,30"
            VerticalAlignment="Bottom"
            FontSize="16"
            Padding="8"/>

            <!-- SEND BUTTON -->
            <Button
            x:Name="sendButton"
            Content="SEND"
            Width="100"
            Height="40"
            Margin="0,0,20,30"
            VerticalAlignment="Bottom"
            HorizontalAlignment="Right"
            Background="Cyan"
            Foreground="Black"
            FontWeight="Bold"
            Click="sendButton_Click"/>

        </Grid>
        <!--end of background grid-->



        <Grid  
            x:Name="username_grid"
            Visibility="Visible">

            <!-- TITLE -->
            <TextBlock
                Text="CYBERSECURITY AWARENESS BOT"
                Foreground="Cyan"
                FontSize="26"
                FontWeight="Bold"
                HorizontalAlignment="Center"
                Margin="0,40,0,0"/>

            <!-- SUBTITLE -->
            <TextBlock
                Text="Enter your username to continue"
                Foreground="White"
                FontSize="16"
                HorizontalAlignment="Center"
                Margin="0,110,0,0"/>

            <!-- USERNAME INPUT -->
            <TextBox
                x:Name="username"
                Width="350"
                Height="55"
                FontSize="18"
                Padding="10"
                Background="#2D2D30"
                Foreground="White"              
                BorderThickness="2"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"/>

            <!-- SUBMIT BUTTON -->
            <Button
                Width="300"
                Height="45"
                Margin="0,120,0,0"
                Content="SUBMIT"
                FontSize="16"
                FontWeight="Bold"
                Background="Cyan"
                Foreground="Black"
                BorderThickness="0"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Click="submit_name"/>

        </Grid>
        <!-- end of username grid -->


    </Grid>
    <!--End of parent grid-->
</Window>
